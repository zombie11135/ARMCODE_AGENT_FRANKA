# Copy to config/local.env (ignored by Git). Launchers source that file.
# Use shell syntax; quote paths containing spaces. External exports take priority.
# Direct `python -m app` does not source this file: run `source config/local.env` first.
export FR3_AGENT_PYTHON="${FR3_AGENT_PYTHON:-python3}"
export OCCLUSION_CAMERA_PYTHON="${OCCLUSION_CAMERA_PYTHON:-${FR3_AGENT_PYTHON}}"
export ARM_AGENT_PYTHON="${ARM_AGENT_PYTHON:-python3}"
export GSNET_PICK_PYTHON="${GSNET_PICK_PYTHON:-python3}"
export ANYGRASP_PYTHON="${ANYGRASP_PYTHON:-python3}"
# Optional SDK compatibility libraries, provisioned outside this repository:
# export ANYGRASP_COMPAT_LIBS='/absolute/path/to/anygrasp_sdk/compat_libs'
# Explicitly choose your API provider; no API key or provider is bundled.
export ARM_AGENT_API_BASE_URL="${ARM_AGENT_API_BASE_URL:-}"
export ARM_AGENT_API_KEY="${ARM_AGENT_API_KEY:-}"
export ARM_AGENT_API_MODEL="${ARM_AGENT_API_MODEL:-gpt-4.1}"
